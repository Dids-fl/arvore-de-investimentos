# Copie para .env e ajuste se necessário. Todas as variáveis são opcionais.
REQUEST_CONNECT_TIMEOUT=5
REQUEST_READ_TIMEOUT=15
MAX_RETRIES=3
RETRY_BACKOFF=0.5
MAX_WORKERS_ATIVOS=4

# Tokens opcionais (os planos gratuitos bastam; deixe vazio se não tiver)
BRAPI_TOKEN=
FMP_API_KEY=

USE_FUNDAMENTUS=true
FILTRO_SETORES=
FILTRO_GOVERNANCA=

MKTCAP_CONSERVADOR=2000000000
MKTCAP_MODERADO=1000000000
MKTCAP_AGRESSIVO=500000000

INVEST_OUTPUT_DIR=.
